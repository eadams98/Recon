# Copy to `.env` at the repo root for Docker Compose host port mappings.
# Service-specific secrets (e.g. JWT) live under `env/` — see comments below.

# --- Host / container ports (Compose interpolates these) ---
RECON_EMAIL_HOST_PORT=4003
RECON_EMAIL_APP_PORT=4003

RECON_REPORT_HOST_PORT=4001
RECON_REPORT_APP_PORT=4001

RECON_CORE_HOST_PORT=4000
RECON_CORE_APP_PORT=4000

RECON_EUREKA_HOST_PORT=8761
RECON_EUREKA_APP_PORT=8761

# 0 = do not publish MySQL to the host (default for local stack)
RECON_MYSQL_HOST_PORT=0
RECON_MYSQL_APP_PORT=0

# --- Docker network service names (used in JDBC URLs and Eureka URLs) ---
EUREKA_SERVICE_NAME=eureka
MYSQL_SERVICE_NAME=mysql

# --- Fullstack overlay (docker-compose.fullstack.yml) ---
RECON_CLIENT_HOST_PORT=3000
RECON_CLIENT_CONTEXT=../MERN/Recon/recon-client

# --- env/mysql.env (referenced by docker-compose.yaml) ---
# MYSQL_ROOT_PASSWORD=root
# MYSQL_USER=eadams
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=recon

# --- env/recon-core.env (JWT signing; local placeholder only) ---
# JWT_SECRET=local-dev-secret-change-me
